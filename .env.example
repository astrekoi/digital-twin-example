# --- runtime ---
APP_ENV=development
LOG_LEVEL=INFO
ALLOW_HARDWARE_RUNTIME=false        # hw-worker refuses to run without this

# --- storage ---
DB_BACKEND=sqlite                   # sqlite | postgres
SQLITE_DB_PATH=data/telemetry.db
POSTGRES_DSN=postgresql://plc:plc@localhost:5432/plc_twin
# psycopg pool size per process role
POOL_MAX_HW=2
POOL_MAX_AI=2
POOL_MAX_EXT=4
POOL_MAX_TAIPY=8

# --- celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TIMEZONE=Europe/Moscow
SAMPLE_PERIOD_S=1.0                 # APScheduler inside hw-worker
APPLY_COMMANDS_PERIOD_S=1.0         # APScheduler inside hw-worker
PREDICT_PERIOD_S=60                 # Celery beat
DIGEST_PERIOD_S=300                 # Celery beat
RETENTION_PERIOD_S=3600             # Celery beat
RETENTION_DAYS=7

# --- AI ---
AI_ENABLED=false
MODELS_DIR=models
MODEL_ID=

# --- external integrations (master gate) ---
ALLOW_EXTERNAL_API_CALLS=false

# --- IPFS ---
IPFS_ENABLED=false
IPFS_PROVIDER=none                  # none | pinata | web3_storage | local
PINATA_JWT=
PINATA_BASE_URL=https://api.pinata.cloud
WEB3_STORAGE_TOKEN=
LOCAL_IPFS_API_URL=http://127.0.0.1:5001

# --- Hedera HCS ---
HEDERA_ENABLED=false
HEDERA_NETWORK=testnet              # testnet | mainnet | previewnet
HEDERA_OPERATOR_ID=                 # format "0.0.<num>"
# HEDERA_OPERATOR_KEY: private key HEX without 0x prefix (32 bytes = 64 hex chars),
# or DER-encoded full key. Example: "0bddfe321c49a2b20d9ace27b602f94556c228a8761e3bceb96beb9425e16fb3"
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=                    # populated by scripts/hedera_poc.py create_topic
HEDERA_TX_FEE_HBAR=2                # max fee per submit (testnet is free)
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# --- taipy ---
TAIPY_HOST=0.0.0.0
TAIPY_PORT=5000
TAIPY_DARK_MODE=true
TAIPY_LIVE_REFRESH_S=1.0
TAIPY_CHARTS_REFRESH_S=5.0
